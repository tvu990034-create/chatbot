# ============================================================
#  local-chatbot – SPEED-FIRST WITH NATIVE INTELLIGENCE
#  Target: MMLU-Pro, GPQA Diamond, ARC-AGI, AIME, MATH, BBH
#  Strategy: Maximize speed + leverage model's native intelligence
# ============================================================

# ----- Benchmark Configuration -----
BENCHMARK_MODEL=ollama/phi3:mini
BENCHMARK_SPEED_REQUESTS=50
BENCHMARK_INTELLIGENCE_QUESTIONS=10
BENCHMARK_OUTPUT_DIR=benchmark_results

# Cost Configuration (per 1K tokens)
COST_PER_1K_INPUT=0.001
COST_PER_1K_OUTPUT=0.002

# Performance Monitoring
ENABLE_PERFORMANCE_MONITORING=true
PERFORMANCE_LOG_FILE=performance_log.json
SNAPSHOT_INTERVAL=60

# ----- Application -----
APP_NAME="Local Chatbot"
DEBUG=false
LOG_LEVEL=INFO

# ----- FastAPI server -----
API_HOST=0.0.0.0
API_PORT=8000

# ----- Gradio UI -----
UI_HOST=0.0.0.0
UI_PORT=7860
UI_SHARE=false
UI_THEME=soft

# UI Rendering Optimizations
UI_DEBOUNCE_THRESHOLD=0.050
UI_BATCH_SIZE=4
UI_MAX_TYPING_CYCLES=10
UI_AGENT_TIMEOUT=30

# ----- Primary LLM -----
# SPEED-OPTIMIZED: Low temperature for consistency, moderate tokens
DEFAULT_MODEL=ollama/phi3:mini
LITELLM_MAX_TOKENS=256
LITELLM_TEMPERATURE=0.1
LITELLM_STREAM=true

# ----- API Keys (optional - for cloud models) -----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=

# ----- Local backend (vllm | sglang | ollama | none) -----
LOCAL_BACKEND=ollama
LOCAL_MODEL_NAME=phi3:mini
LOCAL_BACKEND_HOST=127.0.0.1
LOCAL_BACKEND_PORT=8081
LOCAL_BACKEND_GPU_MEMORY_UTILIZATION=0.90
LOCAL_BACKEND_MAX_MODEL_LEN=8192
LOCAL_BACKEND_DTYPE=auto
LOCAL_BACKEND_QUANTIZATION=awq

# ----- Embeddings -----
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# ----- RAG -----
RAG_PROVIDER=none
RAG_CHUNK_SIZE=256
RAG_CHUNK_OVERLAP=32
RAG_TOP_K=3
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ----- Aider code tool -----
AIDER_AUTO_COMMIT=false
AIDER_READ_ONLY=true

# ----- Performance features (MAXIMUM SPEED) -----
ENABLE_LEGITIMATE_OPTIMIZATIONS=true
PROMPT_COMPRESSION_ENABLED=true
PROMPT_COMPRESSION_METHOD=simple_token_pruning
PROMPT_COMPRESSION_RATIO=0.8
DIFFICULTY_ROUTING_ENABLED=true
DIFFICULTY_THRESHOLD=0.7
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL=7200

# ----- Advanced ML Optimizations (DISABLED for speed) -----
HRR_COMPRESSION_ENABLED=false
HRR_HISTORY_SIZE=10
HRR_COMPRESSION_DIM=128
MOSE_SEGMENTATION_ENABLED=false
MOSE_SEGMENT_LENGTH=2000
MOSE_NUM_SEGMENTS=4
KOOPMAN_MIXING_ENABLED=false
KOOPMAN_MIX_DIM=64
ODE_ADAPTIVE_ITERATIONS_ENABLED=false
ODE_MAX_ITERATIONS=10
ODE_TOLERANCE=0.1

# ----- Safe Post-Training Quantization -----
ENABLE_LLM_INT8=false
LLM_INT8_THRESHOLD=6.0
ENABLE_SMOOTHQUANT=false
SMOOTHQUANT_ALPHA=0.5
ENABLE_AWQ=false
AWQ_BITS=4
AWQ_GROUP_SIZE=128
AWQ_CLIP_RATIO=0.01
ENABLE_GPTQ=false
GPTQ_BITS=4

# ----- High-Impact Model-Level Optimizations (DISABLED) -----
HRR_ATTENTION_ENABLED=false
HRR_ATTENTION_HEADS=8
TENSOR_RING_ENABLED=false
TENSOR_RING_RANK=4
PERFORMER_ATTENTION_ENABLED=false
PERFORMER_NB_FEATURES=64
NEURAL_ODE_ENABLED=false
NEURAL_ODE_MAX_STEPS=6
NEURAL_ODE_TOLERANCE=1.0

# ----- Additional Performance Optimizations -----
FLASH_ATTENTION_ENABLED=false
PERFORMER_ATTENTION_ENABLED=false
PERFORMER_NB_FEATURES=64
LINFORMER_ATTENTION_ENABLED=false
LINFORMER_LOW_RANK_DIM=256
SPECULATIVE_DECODING_ENABLED=false
SPECULATIVE_DRAFT_MODEL=ollama/phi3:mini
SPECULATIVE_SPEC_LEN=5
SPECULATIVE_VERIFY_EVERY=1
KV_CACHE_SIZE=1000
KV_PAGE_SIZE=16
KV_MAX_BLOCKS=100
KV_CACHE_COMPRESSION_ENABLED=true
KV_COMPRESSION_RATIO=0.7

# ----- A-Tier Advanced Optimizations (DISABLED for speed) -----
ENABLE_CONTINUOUS_THOUGHTS=false
N_THOUGHTS=4
ENABLE_REASONING_DEPTH_BUDGET=false
REASONING_LAMBDA=0.1
ENABLE_VARIATIONAL_COMPRESSION=false
VARIATIONAL_BETA=1.0
ENABLE_THOUGHT_EARLY_EXIT=false
EXIT_THRESHOLD=0.95
ENABLE_ATTENTION_SPAN_PREDICTION=false
ENABLE_QUERY_SPARSE_ATTENTION=false
ENABLE_LINEAR_ATTENTION=false
LINEAR_ATTENTION_M=128
ENABLE_ADAPTIVE_VOCAB=false
VOCAB_SHRINK_K=3000
ENABLE_GROUPED_DECODING=false
N_GROUPS=100
ENABLE_DYNAMIC_TOPK=false
MAX_DYNAMIC_K=100
ENABLE_TOKEN_PRECISION_SCHEDULING=false
ENABLE_DYNAMIC_WEIGHT_QUANT=false
ENABLE_PRECISION_ROUTER=false
ENABLE_SSM_REASONING=false
SSM_D_STATE=256
ENABLE_GLU_REASONING=false
ENABLE_FEEDBACK_DRAFT=false

# ----- S-Tier Advanced Optimizations (SPEED-FIRST) -----
ENABLE_SPECULATIVE_DECODING=false
SPECULATIVE_K=3
ENABLE_HIERARCHICAL_SPECULATIVE=false
ENABLE_ADAPTIVE_DRAFT_LENGTH=false
PID_KP=0.5
PID_KI=0.1
PID_KD=0.05
TARGET_ACCEPTANCE=0.9
ENABLE_KV_FREE=true
KV_STATE_SIZE=128
ENABLE_HIERARCHICAL_CACHE=true
CACHE_FINE_WINDOW=512
CACHE_BLOCK_SIZE=16
ENABLE_PROMPT_MINIMISATION=true
MINIMISATION_THRESHOLD=0.90
ENABLE_PREFIX_CACHE=true
CACHE_DIR=./cache
ENABLE_EARLY_EXIT=true
ENABLE_CASCADE_ROUTING=true
CASCADE_THRESHOLD=0.80
ENABLE_RL_ROUTING=false
ENABLE_SYNTAX_MASKING=false
ENABLE_SYNTAX_BEAM_SEARCH=false
BEAM_WIDTH=5
ENABLE_DISTILLED_ATTENTION=false
ATTENTION_SUMMARY_SIZE=128
ENABLE_CUTOFF_BIAS=true
MAX_CUTOFF_DIST=1024

# ----- Advanced Token Optimizations -----
ENABLE_TOKEN_CONTRACTION=false
CONTRACTION_THRESHOLD=2
ENABLE_TOKEN_EXPANSION=false
ENABLE_TEMPLATE_ABBREVIATION=false
TEMPLATE_THRESHOLD=0.9
ENABLE_HIEROGLYPH=false
HIEROGLYPH_THRESHOLD=3
MAX_NGRAM=4
ENABLE_CODE_BLENDING=false

# ----- Optimized Configuration (SPEED-FIRST) -----
ENABLE_REASONING_ENHANCEMENTS=false
ENABLE_ATTENTION_OPTIMIZATIONS=true
ENABLE_VOCABULARY_OPTIMIZATIONS=false
ENABLE_PRECISION_OPTIMIZATIONS=true
ENABLE_OPTIMIZED_ROUTING=true
COMPLEXITY_THRESHOLD=0.7
ABSTENTION_THRESHOLD=0.5
ENABLE_BUDGET_ROUTING=true
MAX_BUDGET=3.0
ENABLE_ADAPTIVE_TEMPERATURE=true
BASE_TEMP=0.1
ENABLE_SELF_CONSISTENCY=false
ENABLE_SIMILARITY_ROUTING=true
SIMILARITY_THRESHOLD=0.9

# ============================================================================
# RESEARCH-BASED INTELLIGENCE CONFIGURATION
# Speed-preserving research paper integrations for benchmark performance
# ============================================================================

# ----- Benchmark Integration Layer -----
ENABLE_BENCHMARK_INTEGRATION=true
BENCHMARK_INTEGRATION_PATH=benchmark_integrations/benchmark_integration_layer.py

# ----- Advanced Model Routing -----
ENABLE_ADVANCED_MODEL_ROUTING=true
ADVANCED_MODEL_ROUTER_PATH=benchmark_integrations/model_router_advanced.py

# ----- Math Reasoning Enhancement -----
ENABLE_MATH_REASONING=true
MATH_REASONING_CONFIG={"enable_cot_templates": true, "max_reasoning_steps": 3}

# ----- Knowledge Graph Integration -----
ENABLE_KNOWLEDGE_GRAPH=true
KNOWLEDGE_GRAPH_CONFIG={"max_entities_per_query": 3, "cache_graph_queries": true}

# ----- Uncertainty Calibration -----
ENABLE_UNCERTAINTY_CALIBRATION=true
UNCERTAINTY_CONFIG={"confidence_threshold": 0.4, "uncertainty_threshold": 0.5}

# ----- Available Models for Routing -----
AVAILABLE_MODELS=phi3_mini,phi3_5_mini,phi1_5,phi2,gemma2b,gemma2_2b,olmo1b,bloom560m,llama3_8b,llama3_8b_base,qwen7b,qwen14b,qwen32b,mistral7b,mistral7b_v2,mistral7b_v1,gemma7b,phi3_small,y1_5_6b,y1_5_9b,olmo7b,bloom7b,falcon11b,nemotron15b,solar10b,zephyr7b,neuralchat7b,openorca_mistral7b,dolphin_mistral7b,nous_hermes2_7b,openhermes_mistral7b,llama3_70b,llama3_70b_base,qwen72b,deepseek_v3,deepseek_llm7b,mixtral_8x22b,falcon180b,solar70b,nemotron40b,y34b,nous_hermes2_70b,nous_hermes2_mixtral,nous_hermes2_yi34b,openorca_mixtral,phi3_medium,codegemma7b,deepseek_coder,openorca_deepseek7b
DEFAULT_ROUTING_MODEL=phi3_mini

# ----- Tree-of-Thoughts (ToT) - DISABLED for speed -----
TOT_ENABLED=false
TOT_MAX_DEPTH=2
TOT_MAX_BRANCHING=2
TOT_MAX_THOUGHTS=3
TOT_SEARCH_STRATEGY=best_first
TOT_BEAM_WIDTH=1
TOT_EARLY_TERMINATION_THRESHOLD=0.85

# ----- New Research Integrations (Priority 4) -----
ENABLE_ZERO_SHOT_COT=true
ZERO_SHOT_COT_REASONING_KEYWORDS=solve,calculate,compute,determine,find,why,how,explain,reason,prove,derive,analyze,evaluate

ENABLE_LEAST_TO_MOST=true
LEAST_TO_MOST_MAX_SUBPROBLEMS=5
LEAST_TO_MOST_COMPLEXITY_THRESHOLD=2

ENABLE_TREE_OF_THOUGHT=true
TREE_OF_THOUGHT_MAX_DEPTH=3
TREE_OF_THOUGHT_MAX_BRANCHES=3

ENABLE_GRAPH_OF_THOUGHT=true
GRAPH_OF_THOUGHT_MAX_VERTICES=10

ENABLE_RATIONALE_ENSEMBLES=true
RATIONALE_ENSEMBLES_NUM_SAMPLES=3

ENABLE_CONTEXT_OPTIMIZER=true
CONTEXT_OPTIMIZER_TARGET_LENGTH=4096

ENABLE_INSTABILITY_MITIGATOR=true
INSTABILITY_MITIGATOR_SAMPLE_REPEATS=3

# ----- Performance Monitoring -----
ENABLE_PERFORMANCE_MONITOR=true
PERFORMANCE_MONITOR_LOG_FILE=performance_log.json
PERFORMANCE_MONITOR_MAX_HISTORY=1000

# ----- Advanced Uncertainty Calibration (Priority 5) -----
ENABLE_ADVANCED_CALIBRATION=true
ADVANCED_CALIBRATION_TEMP_SCALING=true
ADVANCED_CALIBRATION_CONFORMAL_PREDICTION=true
ADVANCED_CALIBRATION_SELECTIVE_PREDICTION=true
ADVANCED_CALIBRATION_ECE_TRACKING=true
ADVANCED_CALIBRATION_TEMPERATURE_INIT=1.0
ADVANCED_CALIBRATION_CONFORMAL_ALPHA=0.1
ADVANCED_CALIBRATION_SELECTIVE_COVERAGE=0.9
ADVANCED_CALIBRATION_HISTORY_WINDOW=100
ADVANCED_CALIBRATION_ECE_BINS=10

# ----- Reflexion - DISABLED for speed -----
REFLEXION_ENABLED=false
REFLEXION_MAX_ATTEMPTS=3
REFLEXION_MAX_EPISODES=20
REFLEXION_TEMPERATURE=0.7
REFLEXION_MEMORY_FILE=data/reflexion_episodes.json

# ----- ReAct - DISABLED for speed -----
REACT_ENABLED=false
REACT_MAX_STEPS=10
REACT_MAX_ITERATIONS=5
REACT_TEMPERATURE=0.7
REACT_ALLOW_SELF_CORRECTION=true
REACT_VERBOSE_THOUGHTS=true

# ----- Graph-of-Thoughts - DISABLED for speed -----
GOT_ENABLED=false
GOT_MAX_NODES=15
GOT_MAX_DEPTH=5
GOT_MAX_BRANCHING=3
GOT_AGGREGATION_METHOD=merge
GOT_ENABLE_AGGREGATION=true
GOT_ENABLE_TRANSFORMATION=true
GOT_EVALUATION_THRESHOLD=0.5
GOT_TOP_K_KEEP=3

# ----- Self-Refine - DISABLED for speed -----
SELF_REFINE_ENABLED=false
SELF_REFINE_MAX_ITERATIONS=1
SELF_REFINE_MIN_IMPROVEMENT=0.05
SELF_REFINE_TEMPERATURE=0.6
SELF_REFINE_EVALUATION_TEMPERATURE=0.3
SELF_REFINE_STOP_THRESHOLD=0.90

# ----- Self-Consistency - DISABLED for speed -----
SELF_CONSISTENCY_ENABLED=false
SELF_CONSISTENCY_NUM_SAMPLES=2
SELF_CONSISTENCY_TEMPERATURE=0.6
SELF_CONSISTENCY_AGGREGATION_STRATEGY=majority_vote
SELF_CONSISTENCY_ANSWER_NORMALIZATION=whitespace
SELF_CONSISTENCY_MIN_AGREEMENT_THRESHOLD=0.5
SELF_CONSISTENCY_ENABLE_CONFIDENCE_SCORING=true
SELF_CONSISTENCY_MAX_REASONING_LENGTH=500

# ----- General Reasoning Configuration -----
REASONING_FRAMEWORK=default
REASONING_TIMEOUT=15
ENABLE_REASONING_CACHE=true
REASONING_CACHE_TTL=7200

# ----- Factuality - LIGHTWEIGHT for benchmark accuracy -----
FACTUALITY_ENABLED=true
FACTUALITY_CONFIDENCE_THRESHOLD=0.3
FACTUALITY_UNCERTAINTY_THRESHOLD=0.3
FACTUALITY_LOG_HALLUCINATIONS=true

# ----- Advanced Equation-Based Reasoning (DISABLED for speed) -----
GEODESIC_FLOW_ENABLED=false
GEODESIC_HIDDEN_DIM=512
GEODESIC_REGULARIZATION_WEIGHT=0.1
GEODESIC_MAX_ITERATIONS=100

ADAPTIVE_DEPTH_ENABLED=false
ADAPTIVE_DEPTH_COST_LAMBDA=0.01
ADAPTIVE_DEPTH_MIN_STEPS=1
ADAPTIVE_DEPTH_MAX_STEPS=5
ADAPTIVE_DEPTH_CONFIDENCE_THRESHOLD=0.95

ABDUCTIVE_LEAP_ENABLED=false
ABDUCTIVE_LAMBDA_SIMPLICITY=0.1
ABDUCTIVE_NUM_HYPOTHESES=5

COUNTERFACTURAL_ROBUSTNESS_ENABLED=false
COUNTERFACTURAL_NUM_PERTURBATIONS=5
COUNTERFACTURAL_PERTURBATION_STRENGTH=0.1
COUNTERFACTURAL_SIMILARITY_THRESHOLD=0.8

META_CONTROLLER_ENABLED=false
META_CONTROLLER_STOP_THRESHOLD=0.05
META_CONTROLLER_HIDDEN_DIM=64

RECURSIVE_CRITIQUE_ENABLED=false
RECURSIVE_CRITIQUE_ITERATIONS=3
RECURSIVE_CRITIQUE_LEARNING_RATE=0.01

QUANTUM_REASONING_ENABLED=false
QUANTUM_STATE_DIM=8
QUANTUM_ENABLE_INTERFERENCE=true
QUANTUM_DECOHERENCE_RATE=0.001

ACTIVE_INFERENCE_ENABLED=false
ACTIVE_INFERENCE_COMPLEXITY_WEIGHT=0.5
ACTIVE_INFERENCE_PLANNING_HORIZON=3
ACTIVE_INFERENCE_PRIOR_STRENGTH=1.0

# ----- Continuous Batching -----
CONTINUOUS_BATCH_SIZE=32
MAX_SEQUENCE_LENGTH=2048

# ----- Kernel Fusion & torch.compile -----
KERNEL_FUSION_ENABLED=false
TORCH_COMPILE_MODE=reduce-overhead

# ----- Model Conversion -----
MODEL_CONVERSION_FORMAT=gguf
MODEL_CONVERSION_TARGET=auto