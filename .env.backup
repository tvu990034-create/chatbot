# ============================================================
#  local-chatbot – essential environment variables
#  Copy this file to .env and fill in your values.
#  
#  For advanced performance tuning options, see .env.advanced.example
# ============================================================

# ----- Application -----
APP_NAME="Local Chatbot"
DEBUG=false
LOG_LEVEL=INFO

# ----- FastAPI server -----
API_HOST=0.0.0.0
API_PORT=8000

# ----- Gradio UI -----
UI_HOST=0.0.0.0
UI_PORT=7860
UI_SHARE=false
UI_THEME=soft

# UI Rendering Optimizations
UI_DEBOUNCE_THRESHOLD=0.050
UI_BATCH_SIZE=4
UI_MAX_TYPING_CYCLES=10
UI_AGENT_TIMEOUT=30

# ----- Primary LLM -----
DEFAULT_MODEL=ollama/phi3:mini
# LITELLM_API_BASE=
# Performance tuning: reduced max_tokens and temperature for faster responses
LITELLM_MAX_TOKENS=256
LITELLM_TEMPERATURE=0.1
LITELLM_STREAM=true

# ----- API Keys (optional - for cloud models) -----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=

# ----- Local backend (vllm | sglang | ollama | none) -----
LOCAL_BACKEND=ollama
LOCAL_MODEL_NAME=phi3:mini
LOCAL_BACKEND_HOST=127.0.0.1
LOCAL_BACKEND_PORT=8080
LOCAL_BACKEND_GPU_MEMORY_UTILIZATION=0.90
LOCAL_BACKEND_MAX_MODEL_LEN=8192
LOCAL_BACKEND_DTYPE=auto
LOCAL_BACKEND_QUANTIZATION=awq

# ----- Embeddings -----
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# ----- RAG -----
RAG_PROVIDER=none
RAG_CHUNK_SIZE=256
RAG_CHUNK_OVERLAP=32
RAG_TOP_K=3
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ----- Aider code tool -----
# AIDER_REPO_PATH=/path/to/your/project
AIDER_AUTO_COMMIT=false
AIDER_READ_ONLY=true

# ----- Performance features (optional) -----
# Enable legitimate research paper optimizations
ENABLE_LEGITIMATE_OPTIMIZATIONS=true

# Legitimate optimizations based on research papers
# Prompt compression (LLMLingua #31, Selective Context #32)
PROMPT_COMPRESSION_ENABLED=true
PROMPT_COMPRESSION_METHOD=simple_token_pruning
PROMPT_COMPRESSION_RATIO=0.5

# Difficulty-based routing (CALM #45, LayerSkip #50)
DIFFICULTY_ROUTING_ENABLED=true
DIFFICULTY_THRESHOLD=0.5

# Response caching for repeated queries
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL=3600

# Legacy fake equations (disabled - these were non-functional)
ENABLE_PERFORMANCE_EQUATIONS=false

# --- Eq1: Multi-Turn State Recycling (KV-cache reuse) ---
EQ1_PREFILL_MS_PER_TOKEN=5.0

# --- Eq2: Prefetch-and-Overlap Latency Hiding ---
EQ2_RAG_PREFETCH_ENABLED=true
EQ2_PREFETCH_TIMEOUT_S=10.0
EQ2_PREFETCH_TIMEOUT_S=10.0

# --- Eq3/Eq7: Cost-Token Elasticity Router ---
ROUTER_ENABLED=false
ROUTER_FAST_MODEL=ollama/phi3:mini
ROUTER_TOKEN_THRESHOLD=32
ROUTER_OVERHEAD_S=0.001
ROUTER_FALLBACK_FRACTION=0.05
ROUTER_T_SLOW_S=2.0
ROUTER_T_FAST_S=0.3
ROUTER_COST_SLOW_PER_1K=0.010
ROUTER_COST_FAST_PER_1K=0.001

# --- Eq4: Exponential Fuzzy Cache ---
CACHE_MAX_SIZE=500
CACHE_TARGET_HIT_RATE=0.80

# --- Eq5: Amdahl Pre-warming ---
PREWARM_F=0.555
PREWARM_ALPHA=100.0
PREWARM_W=0.05

# --- Eq6: Dynamic TTL Cache ---
CACHE_TTL_BASE=3600.0
CACHE_TTL_MAX=86400.0
CACHE_BETA=2.0
CACHE_GAMMA=1.5

# --- Eq8: Confidence-Gated Token Budget ---
EQ8_M_MIN=20
EQ8_M_MAX=256
EQ8_THETA=5.0
EQ8_GATE_THRESHOLD=0.45

# --- Eq9: SLO-Anchored Latency Anomaly Detector ---
SLO_THRESHOLD_MS=1000.0
ANOMALY_WINDOW_SIZE=200
ANOMALY_MIN_SAMPLES=50
ANOMALY_K_FACTOR=3.0
ANOMALY_COOLDOWN_SECONDS=300.0
ANOMALY_DRY_RUN=true
ANOMALY_ALERT_ENABLED=true

# ----- Advanced ML Optimizations (optional) -----
# See .env.advanced.example for HRR, MoSE, Koopman, and Neural ODE optimizations
# All are disabled by default for safety

# --- HRR-inspired History Compression ---
HRR_COMPRESSION_ENABLED=false
HRR_HISTORY_SIZE=10
HRR_COMPRESSION_DIM=128

# --- MoSE-inspired Request Segmentation ---
MOSE_SEGMENTATION_ENABLED=false
MOSE_SEGMENT_LENGTH=2000
MOSE_NUM_SEGMENTS=4

# --- Koopman-inspired Context Mixing ---
KOOPMAN_MIXING_ENABLED=false
KOOPMAN_MIX_DIM=64

# --- Neural ODE-inspired Adaptive Iterations ---
ODE_ADAPTIVE_ITERATIONS_ENABLED=false
ODE_MAX_ITERATIONS=10
ODE_TOLERANCE=0.1

# --- Production-Tested Optimizations ---
# --- Eq26: Dual-Layer Caching ---
DUAL_CACHE_ENABLED=true
DUAL_CACHE_MEMORY_TTL=300
DUAL_CACHE_REDIS_TTL=3600
DUAL_CACHE_MAX_ENTRIES=1000
DUAL_CACHE_USE_REDIS=false

# --- Eq27: Query Caching ---
QUERY_CACHE_ENABLED=false
QUERY_CACHE_MAX_ENTRIES=500
QUERY_CACHE_TTL=600

# --- Eq28: RRF Fusion ---
RRF_FUSION_ENABLED=false
RRF_K=60
RRF_TOP_K=10

# --- Eq29: Multi-Query Retrieval ---
MULTI_QUERY_ENABLED=false
MULTI_QUERY_NUM_QUERIES=3
MULTI_QUERY_MAX_WORKERS=4

# --- Eq30: Async Task Preparation ---
ASYNC_TASK_ENABLED=false
ASYNC_TASK_MAX_CONCURRENT=10

# --- Eq31: SimHash Cache ---
SIMHASH_ENABLED=false
SIMHASH_THRESHOLD=3
SIMHASH_CACHE_SIZE=1000

# --- Eq32: Context Compression ---
CONTEXT_COMPRESSION_ENABLED=false
CONTEXT_MAX_TOKENS=4096
CONTEXT_COMPRESSION_RATIO=0.7

# --- Eq33: Early Exit ---
EARLY_EXIT_ENABLED=false
EARLY_EXIT_CONFIDENCE=0.95
EARLY_EXIT_MAX_TOKENS=50

# ============================================================================
# SAFE POST-TRAINING QUANTIZATION (from research papers)
# These are safe, non-breaking optimizations that don't require retraining
# ============================================================================

# --- LLM.int8() - Mixed precision decomposition (2x memory reduction) ---
ENABLE_LLM_INT8=true
LLM_INT8_THRESHOLD=6.0

# --- SmoothQuant - Activation smoothing (1.56x speedup) ---
ENABLE_SMOOTHQUANT=true
SMOOTHQUANT_ALPHA=0.5

# --- AWQ - Activation-aware quantization (3x+ speedup) ---
ENABLE_AWQ=true
AWQ_CLIP_RATIO=0.01

# --- GPTQ - Weight quantization (3.25-4.5x speedup) ---
ENABLE_GPTQ=true
GPTQ_BITS=4

# ============================================================================
# HIGH-IMPACT MODEL-LEVEL OPTIMIZATIONS (from research papers)
# These provide massive speedups but require model architecture changes
# ============================================================================

# --- HRR Attention - 10x speedup, 1000x memory reduction ---
HRR_ATTENTION_ENABLED=true
HRR_ATTENTION_HEADS=8

# --- Tensor Ring Linear - 60x parameter compression, 5x speedup ---
TENSOR_RING_ENABLED=false
TENSOR_RING_RANK=4

# --- Performer Linear Attention - 9x speedup ---
PERFORMER_ATTENTION_ENABLED=false
PERFORMER_NB_FEATURES=64

# --- Neural ODE-Driven Depth - 2.5x speedup ---
NEURAL_ODE_ENABLED=false
NEURAL_ODE_MAX_STEPS=6
NEURAL_ODE_TOLERANCE=1.0

# ============================================================================
# ADDITIONAL PERFORMANCE OPTIMIZATIONS
# ============================================================================

# --- FlashAttention Configuration - 2-4x faster attention ---
FLASH_ATTENTION_ENABLED=true

# --- Performer Attention Configuration ---
PERFORMER_ATTENTION_ENABLED=false
PERFORMER_NB_FEATURES=64

# --- Linformer Attention Configuration ---
LINFORMER_ATTENTION_ENABLED=false
LINFORMER_LOW_RANK_DIM=256

# --- Speculative Decoding Configuration ---
SPECULATIVE_DECODING_ENABLED=false
SPECULATIVE_DRAFT_MODEL=ollama/phi3:mini
SPECULATIVE_SPEC_LEN=5
SPECULATIVE_VERIFY_EVERY=1

# --- KV Cache Optimization ---
KV_CACHE_SIZE=1000
KV_PAGE_SIZE=16
KV_MAX_BLOCKS=100

# ============================================================================
# ADVANCED REASONING TECHNIQUES
# ============================================================================

# --- Tree-of-Thoughts (ToT) Reasoning ---
TOT_ENABLED=true
TOT_MAX_DEPTH=5
TOT_MAX_BRANCHING=3
TOT_MAX_THOUGHTS=10
TOT_SEARCH_STRATEGY=best_first
TOT_BEAM_WIDTH=2
TOT_EARLY_TERMINATION_THRESHOLD=0.9

# --- Reflexion Self-Reflection ---
REFLEXION_ENABLED=false
REFLEXION_MAX_ATTEMPTS=3
REFLEXION_MAX_EPISODES=20
REFLEXION_TEMPERATURE=0.7
REFLEXION_MEMORY_FILE=data/reflexion_episodes.json

# --- ReAct Reasoning + Acting ---
REACT_ENABLED=true
REACT_MAX_STEPS=10
REACT_MAX_ITERATIONS=5
REACT_TEMPERATURE=0.7
REACT_ALLOW_SELF_CORRECTION=true
REACT_VERBOSE_THOUGHTS=true

# --- Graph-of-Thoughts (GoT) Reasoning ---
GOT_ENABLED=false
GOT_MAX_NODES=15
GOT_MAX_DEPTH=5
GOT_MAX_BRANCHING=3
GOT_AGGREGATION_METHOD=merge
GOT_ENABLE_AGGREGATION=true
GOT_ENABLE_TRANSFORMATION=true
GOT_EVALUATION_THRESHOLD=0.5
GOT_TOP_K_KEEP=3

# --- Self-Refine Framework ---
SELF_REFINE_ENABLED=true
SELF_REFINE_MAX_ITERATIONS=3
SELF_REFINE_MIN_IMPROVEMENT=0.1
SELF_REFINE_TEMPERATURE=0.7
SELF_REFINE_EVALUATION_TEMPERATURE=0.3
SELF_REFINE_STOP_THRESHOLD=0.95

# --- Self-Consistency Framework ---
SELF_CONSISTENCY_ENABLED=true
SELF_CONSISTENCY_NUM_SAMPLES=5
SELF_CONSISTENCY_TEMPERATURE=0.7
SELF_CONSISTENCY_AGGREGATION_STRATEGY=majority_vote
SELF_CONSISTENCY_ANSWER_NORMALIZATION=whitespace
SELF_CONSISTENCY_MIN_AGREEMENT_THRESHOLD=0.6
SELF_CONSISTENCY_ENABLE_CONFIDENCE_SCORING=true
SELF_CONSISTENCY_MAX_REASONING_LENGTH=1000

# --- General Reasoning Configuration ---
REASONING_FRAMEWORK=default
REASONING_TIMEOUT=60
ENABLE_REASONING_CACHE=true
REASONING_CACHE_TTL=3600

# --- Continuous Batching ---
CONTINUOUS_BATCH_SIZE=32
MAX_SEQUENCE_LENGTH=2048

# --- Kernel Fusion & torch.compile ---
KERNEL_FUSION_ENABLED=true
TORCH_COMPILE_MODE=reduce-overhead

# --- Model Conversion ---
MODEL_CONVERSION_FORMAT=gguf
MODEL_CONVERSION_TARGET=auto
