# ============================================================
#  local-chatbot – advanced performance tuning
#  
#  Copy the relevant sections to your .env file to enable
#  advanced performance optimizations and research features.
#  
#  Most users don't need these - the defaults work well.
# ============================================================

# ============================================================
# PERFORMANCE EQUATIONS (Eq1-Eq9)
# ============================================================

# --- Eq1: Multi-Turn State Recycling (KV-cache reuse) ---
# Estimated prefill speed of your model in ms per token.
# Used to compute TTFB-reduction speedup in logs.
EQ1_PREFILL_MS_PER_TOKEN=5.0

# --- Eq2: Prefetch-and-Overlap Latency Hiding ---
# Fire RAG retrieval concurrently with LLM prefill to hide retrieval latency.
EQ2_RAG_PREFETCH_ENABLED=true
EQ2_PREFETCH_TIMEOUT_S=10.0

# --- Eq3/Eq7: Cost-Token Elasticity Router ---
# Route simple queries to a cheap fast model, complex queries to the full model.
ROUTER_ENABLED=true
ROUTER_FAST_MODEL=ollama/phi3       # cheap model for simple queries
ROUTER_TOKEN_THRESHOLD=64            # predicted token cap below which fast model is used
ROUTER_OVERHEAD_S=0.001              # τ: router decision time in seconds
ROUTER_FALLBACK_FRACTION=0.02        # φ: fraction of fast calls that fall back
ROUTER_T_SLOW_S=2.0                  # baseline latency of slow model (seconds)
ROUTER_T_FAST_S=0.5                  # baseline latency of fast model (seconds)
ROUTER_COST_SLOW_PER_1K=0.010        # cost per 1k tokens – slow model (USD)
ROUTER_COST_FAST_PER_1K=0.001        # cost per 1k tokens – fast model (USD)

# --- Eq4: Exponential Fuzzy Cache ---
# SmartCache with auto-tuned SimHash Hamming threshold.
CACHE_MAX_SIZE=2000
CACHE_TARGET_HIT_RATE=0.90           # target hit rate for the auto-tuner

# --- Eq5: Amdahl Pre-warming ---
# Used at startup to log whether pre-warming the RAG index is worth it.
PREWARM_F=0.555       # fraction of parallel work that benefits from pre-warming
PREWARM_ALPHA=100.0   # speedup factor of pre-warmed work
PREWARM_W=0.05        # normalised pre-warming overhead

# --- Eq6: Dynamic TTL Cache ---
CACHE_TTL_BASE=3600.0    # baseline TTL in seconds (1 hour)
CACHE_TTL_MAX=86400.0    # maximum TTL in seconds (24 hours)
CACHE_BETA=2.0           # β: sensitivity to query frequency
CACHE_GAMMA=1.5          # γ: sensitivity to phrasing diversity

# --- Eq7: Router Speedup (see Eq3 section above) ---
# No extra vars – all covered by ROUTER_* above.

# --- Eq8: Confidence-Gated Token Budget ---
# If the RAG reranker score is below EQ8_GATE_THRESHOLD, skip the LLM call.
# Otherwise token budget = M_min + (M_max - M_min) * (1 - e^(-θ * score))
EQ8_M_MIN=20             # min max_tokens (floor)
EQ8_M_MAX=256            # max max_tokens (ceiling)
EQ8_THETA=5.0            # θ: steepness of the curve
EQ8_GATE_THRESHOLD=0.45  # hard gate – below this confidence no LLM call is made

# --- Eq9: SLO-Anchored Latency Anomaly Detector ---
# Alert fires only when: L > T_SLO  AND  L > μ_rolling + k·σ_rolling
SLO_THRESHOLD_MS=1000.0         # T_SLO: absolute SLO limit in milliseconds
ANOMALY_WINDOW_SIZE=200          # W: rolling window (recent requests)
ANOMALY_MIN_SAMPLES=50           # minimum samples before alerts can fire
ANOMALY_K_FACTOR=3.0             # k: std-dev multiplier for statistical gate
ANOMALY_COOLDOWN_SECONDS=300.0   # cooldown between consecutive alerts
ANOMALY_DRY_RUN=true             # true = log only, false = send to Slack
ANOMALY_ALERT_ENABLED=true       # master on/off switch

# --- Slack webhook for Eq9 anomaly alerts -----
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Eq19: Best-of-N Sampling ---
BON_COST_PER_SAMPLE=0.005        # estimated cost per LLM sample in USD
BON_MAX_N=3                      # maximum number of samples for Best-of-N

# ============================================================
# ADVANCED RESEARCH OPTIMIZATIONS (OPTIONAL)
# ============================================================
# These features are from major research papers but are completely
# optional. The chatbot works perfectly without them.
# Enable only if you understand the implications and have compatible
# hardware/models. All features are disabled by default for safety.

# --- Eq20: Rotary Position Embedding (RoPE) - arXiv:2104.09864 ---
ROPE_ENABLED=false               # Enable RoPE for better positional encoding
ROPE_DIM=64                      # Dimension of rotary embedding
ROPE_BASE=10000                  # Base frequency for RoPE
ROPE_MAX_SEQ_LEN=8192            # Maximum sequence length
ROPE_SCALING_FACTOR=1.0          # NTK-aware scaling for context extension

# --- Eq21: Flash Attention - arXiv:2209.10655 ---
FLASH_ATTENTION_ENABLED=false     # Enable Flash Attention for speed
FLASH_ATTENTION_DROPOUT=0.0      # Dropout rate for Flash Attention

# --- Eq22: Paged Attention - arXiv:2102.03902 ---
PAGED_ATTENTION_ENABLED=false    # Enable Paged Attention for memory efficiency
PAGED_BLOCK_SIZE=16              # Tokens per memory block
PAGED_NUM_GPU_BLOCKS=1024        # Number of GPU memory blocks

# --- Eq23: LoRA - arXiv:2002.05202 ---
LORA_ENABLED=false               # Enable LoRA for parameter-efficient fine-tuning
LORA_RANK=8                      # Low-rank dimension
LORA_ALPHA=16                    # Scaling factor

# ============================================================
# PRODUCTION-TESTED OPTIMIZATIONS (OPTIONAL)
# ============================================================
# These are battle-tested techniques from major projects (LiteLLM, 
# Open-WebUI, Haystack, LlamaIndex, vLLM, SGLang, Aider).
# All features are disabled by default for safety.

# --- Eq26: Dual-Layer Caching (LiteLLM pattern) ---
DUAL_CACHE_ENABLED=false         # Enable dual-layer caching (memory + Redis)
DUAL_CACHE_MEMORY_TTL=300        # Memory cache TTL in seconds (5 min)
DUAL_CACHE_REDIS_TTL=3600        # Redis cache TTL in seconds (1 hour)
DUAL_CACHE_MAX_ENTRIES=1000       # Max entries in memory cache
DUAL_CACHE_USE_REDIS=false       # Enable Redis layer for persistence

# --- Eq27: Query Caching (Open-WebUI pattern) ---
QUERY_CACHE_ENABLED=false         # Enable query caching
QUERY_CACHE_MAX_ENTRIES=500       # Max cached queries
QUERY_CACHE_TTL=600              # Cache TTL in seconds (10 min)

# --- Eq28: RRF Fusion (Haystack/LlamaIndex pattern) ---
RRF_FUSION_ENABLED=false         # Enable Reciprocal Rank Fusion
RRF_K=60                         # RRF constant (typically 60)
RRF_TOP_K=10                     # Results to return after fusion

# --- Eq29: Multi-Query Retrieval (Haystack pattern) ---
MULTI_QUERY_ENABLED=false        # Enable multi-query retrieval
MULTI_QUERY_NUM_QUERIES=3         # Number of query variations
MULTI_QUERY_MAX_WORKERS=4        # Max concurrent workers

# --- Eq30: Async Task Preparation (LangGraph pattern) ---
ASYNC_TASK_ENABLED=false          # Enable optimized async task preparation
ASYNC_TASK_MAX_CONCURRENT=10     # Max concurrent async tasks

# ============================================================
# CHATBOT-PHASE1 EXCELLENT EQUATIONS (OPTIONAL)
# ============================================================
# These are proven techniques from the old project that worked well.
# All features are disabled by default for safety.

# --- Eq31: SimHash Cache (chatbot-phase1 pattern) ---
SIMHASH_ENABLED=false             # Enable SimHash-based query deduplication
SIMHASH_THRESHOLD=3               # Hamming distance threshold for similarity
SIMHASH_CACHE_SIZE=1000          # Max number of cached queries

# --- Eq32: Context Compression (chatbot-phase1 pattern) ---
CONTEXT_COMPRESSION_ENABLED=false # Enable context compression for long conversations
CONTEXT_MAX_TOKENS=4096          # Maximum context tokens after compression
CONTEXT_COMPRESSION_RATIO=0.7     # Target compression ratio

# --- Eq33: Early Exit (chatbot-phase1 pattern) ---
EARLY_EXIT_ENABLED=false          # Enable early exit for simple queries
EARLY_EXIT_CONFIDENCE=0.95        # Confidence threshold for early exit
EARLY_EXIT_MAX_TOKENS=50          # Max tokens to generate before checking for early exit

# ============================================================
# ADVANCED ML OPTIMIZATIONS (SAFE IMPLEMENTATIONS)
# ============================================================
# These apply optimization CONCEPTS to orchestration layer only.
# They do NOT modify LLM architectures directly.
# All features are disabled by default for safety.

# --- HRR-inspired History Compression ---
# Concept: Fixed-size conversation history compression
# Safe application: History compression at orchestration level
HRR_COMPRESSION_ENABLED=false
HRR_HISTORY_SIZE=10              # Number of recent messages to keep
HRR_COMPRESSION_DIM=128          # Dimension of compressed context

# --- MoSE-inspired Request Segmentation ---
# Concept: Split long requests into parallel segments
# Safe application: Request-level segmentation for processing
MOSE_SEGMENTATION_ENABLED=false
MOSE_SEGMENT_LENGTH=2000         # Max characters per segment
MOSE_NUM_SEGMENTS=4              # Number of segments

# --- Koopman-inspired Context Mixing ---
# Concept: Global context mixing using fixed projections
# Safe application: RAG result aggregation
KOOPMAN_MIXING_ENABLED=false
KOOPMAN_MIX_DIM=64               # Dimension for mixing projection

# --- Neural ODE-inspired Adaptive Iterations ---
# Concept: Adaptive iteration based on convergence
# Safe application: Agent loop termination
ODE_ADAPTIVE_ITERATIONS_ENABLED=false
ODE_MAX_ITERATIONS=10            # Maximum iterations
ODE_TOLERANCE=0.1                # Convergence tolerance (0.0-1.0)
