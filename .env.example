# Model Configuration
MODEL_PATH=models/tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf
KNOWLEDGE_BASE_PATH=data/knowledge_base

# Model Parameters
N_CTX=2048
N_THREADS=0
N_GPU_LAYERS=-1
N_BATCH=512
TEMPERATURE=0.7
MAX_TOKENS=1024

# Retrieval Parameters
CHUNK_LIMIT=3

# Fast Paths (enabled for speed, can be disabled for pure AI)
USE_FAQ=true
USE_ZERO_TOKEN=true

# Optimization
ONE_LINER_MODE=false
LAZY_LOAD_MODEL=true

# Server
HOST=0.0.0.0
PORT=8000
