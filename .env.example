# ============================================================
#  local-chatbot – essential environment variables
#  Copy this file to .env and fill in your values.
#  
#  For advanced performance tuning options, see .env.advanced.example
# ============================================================

# ----- Application -----
APP_NAME="Local Chatbot"
DEBUG=false
LOG_LEVEL=INFO

# ----- FastAPI server -----
API_HOST=0.0.0.0
API_PORT=8000

# ----- Gradio UI -----
UI_HOST=0.0.0.0
UI_PORT=7860
UI_SHARE=false

# ----- Primary LLM -----
DEFAULT_MODEL=ollama/llama3
# LITELLM_API_BASE=
LITELLM_MAX_TOKENS=2048
LITELLM_TEMPERATURE=0.7
LITELLM_STREAM=true

# ----- API Keys (optional - for cloud models) -----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=

# ----- Local backend (vllm | sglang | ollama | none) -----
LOCAL_BACKEND=ollama
LOCAL_MODEL_NAME=meta-llama/Meta-Llama-3-8B-Instruct
LOCAL_BACKEND_HOST=127.0.0.1
LOCAL_BACKEND_PORT=8080
LOCAL_BACKEND_GPU_MEMORY_UTILIZATION=0.90
LOCAL_BACKEND_MAX_MODEL_LEN=8192
LOCAL_BACKEND_DTYPE=auto
# LOCAL_BACKEND_QUANTIZATION=awq

# ----- Embeddings -----
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# ----- RAG -----
RAG_PROVIDER=llama_index
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ----- Aider code tool -----
# AIDER_REPO_PATH=/path/to/your/project
AIDER_AUTO_COMMIT=false
AIDER_READ_ONLY=true

# ----- LoRA/QLoRA Fine-Tuning Configuration -----
# Fine-tuning method: lora, qlora, full, ada_lora, dora
FINETUNING_METHOD=qlora

# LoRA parameters (original LoRA paper: https://arxiv.org/abs/2106.09685)
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=["q_proj", "k_proj", "v_proj", "o_proj"]
LORA_BIAS=none
LORA_TASK_TYPE=CAUSAL_LM

# QLoRA parameters (QLoRA paper: https://arxiv.org/abs/2305.14314)
QLORA_BITS=4
QLORA_QUANTIZATION_TYPE=nf4
QLORA_DOUBLE_QUANT=true
QLORA_COMPUTE_DTYPE=bfloat16
QLORA_USE_GRADIENT_CHECKPOINTING=true

# AdaLoRA parameters (AdaLoRA paper: https://arxiv.org/abs/2303.10512)
ADALORA_INIT_R=16
ADALORA_TARGET_R=8
ADALORA_TOTA_STEP=1000
ADALORA_DELTA_T=10

# DoRA parameters (DoRA paper: https://arxiv.org/abs/2402.09353)
DORA_WEIGHT_DECOMPOSE=false

# Training hyperparameters
FINETUNING_LEARNING_RATE=2e-4
FINETUNING_BATCH_SIZE=4
FINETUNING_GRADIENT_ACCUMULATION_STEPS=1
FINETUNING_NUM_EPOCHS=3
FINETUNING_WARMUP_STEPS=100
FINETUNING_LR_SCHEDULER_TYPE=cosine
FINETUNING_WEIGHT_DECAY=0.01
FINETUNING_MAX_GRAD_NORM=1.0

# Fine-tuning data configuration
FINETUNING_DATASET_NAME=gsm8k
FINETUNING_DATASET_SPLIT=train
FINETUNING_MAX_SAMPLES=-1
FINETUNING_MAX_SEQ_LENGTH=512
FINETUNING_TEMPLATE=alpaca

# Fine-tuning paths
FINETUNING_OUTPUT_DIR=./data/adapters
FINETUNING_CACHE_DIR=./data/cache
FINETUNING_LOGGING_DIR=./data/logs

# Multi-LoRA serving (LoRA-Hub: https://arxiv.org/abs/2307.13269)
MULTI_LORA_ENABLED=false
MULTI_LORA_MAX_ADAPTERS=8
MULTI_LORA_ADAPTER_DIR=./data/adapters

# Fine-tuning evaluation
FINETUNING_EVAL_SPLIT=test
FINETUNING_EVAL_STEPS=500
FINETUNING_SAVE_STEPS=500
FINETUNING_SAVE_TOTAL_LIMIT=3

# ----- Performance features (optional) -----
# Enable advanced performance optimizations
# ENABLE_PERFORMANCE_EQUATIONS=false

# ----- Advanced Research Quantization (optional) -----
# Cutting-edge quantization techniques from recent research papers
# All are disabled by default - enable only if you understand the implications

# ZeroQuant: Layer-by-layer quantization with INT8/FP16 support
# ENABLE_ZEROQUANT=false
# ZEROQUANT_BITS=8
# ZEROQUANT_METHOD=int8

# ZeroQuant-FP: FP8 and INT4 quantization with advanced scaling
# ENABLE_ZEROQUANT_FP=false
# ZEROQUANT_FP_BITS=4
# ZEROQUANT_FP_FORMAT=int4

# QLoRA: NF4 data type and double quantization
# ENABLE_QLORA=false
# QLORA_BITS=4
# QLORA_DOUBLE_QUANT=true
# QLORA_NF4=true

# OmniQuant: Learnable weight clipping and equivalent transformations
# ENABLE_OMNIQUANT=false
# OMNIQUANT_BITS=4
# OMNIQUANT_LEARNABLE_CLIP=true
# OMNIQUANT_LET_TRANSFORM=true

# BitNet b1.58: Ternary quantization for extreme compression
# ENABLE_BITNET=false
# BITNET_TERNARY=true
# BITNET_LEARNABLE_SCALE=false

# LLM-FP8: FP8 quantization with per-token/per-channel scaling
# ENABLE_LLM_FP8=false
# LLM_FP8_PER_TOKEN=true
# LLM_FP8_PER_CHANNEL=true

# ----- Advanced Prompt Caching & KV Cache Management (optional) -----
# Cutting-edge caching techniques for efficient LLM inference
# All are disabled by default - enable only if you understand the implications

# Prefix Caching (PagedAttention-style)
# ENABLE_PREFIX_CACHING=false
# PREFIX_CACHE_SIZE=1000
# PREFIX_HASH_ALGORITHM=sha256

# KV Cache Compression & Eviction
# ENABLE_KV_CACHE_COMPRESSION=false
# KV_CACHE_POLICY=h2o
# KV_CACHE_SIZE=4096

# KV Cache Quantization
# ENABLE_KV_QUANTIZATION=false
# KV_QUANTIZATION_BITS=8
# KV_QUANTIZATION_METHOD=kivi

# Attention Sinks & Sliding Window (StreamingLLM)
# ENABLE_ATTENTION_SINKS=false
# ATTENTION_SINK_TOKENS=4
# SLIDING_WINDOW_SIZE=1024

# Prompt Compression (LLMLingua-inspired)
# ENABLE_PROMPT_COMPRESSION=false
# COMPRESSION_RATIO=0.5
# COMPRESSION_METHOD=importance

# Session-based KV Cache Reuse
# ENABLE_SESSION_REUSE=false
# SESSION_SIMILARITY_THRESHOLD=0.8
# MAX_SESSIONS=100

# ----- Advanced Batching & Continuous Batching (optional) -----
# Cutting-edge batching techniques for efficient LLM serving
# All are disabled by default - enable only if you understand the implications

# Continuous Batching (Orca-style)
# ENABLE_CONTINUOUS_BATCHING=false
# CONTINUOUS_BATCH_SIZE=32
# MAX_SEQUENCE_LENGTH=2048

# Dynamic Batching with Timeout
# ENABLE_DYNAMIC_BATCHING=false
# BATCH_TIMEOUT_MS=10.0
# MIN_BATCH_SIZE=1

# Prefill/Decode Phase Splitting (Splitwise, SARATHI-style)
# ENABLE_PHASE_SPLITTING=false
# MAX_PREFILL_BATCH_SIZE=8
# MAX_DECODE_BATCH_SIZE=32
# PREFILL_DECODE_RATIO=0.3

# Cache-Aware Batch Scheduling (Prefix Reuse)
# ENABLE_CACHE_AWARE_BATCHING=false
# CACHE_HIT_BONUS=2.0

# SLO-Aware Scheduling
# ENABLE_SLO_AWARE_BATCHING=false
# SLO_LATENCY_P50=100.0
# SLO_LATENCY_P99=500.0

# Throughput/Latency Optimization
# ENABLE_THROUGHPUT_OPTIMIZATION=false
# TARGET_THROUGHPUT=100.0

# Scheduling Policy
# SCHEDULING_POLICY=fifo

# ----- Grammar-Based Output Constraints (optional) -----
# Constrained generation techniques for structured output
# All are disabled by default - enable only if you understand the implications

# Regex/FSM Constraints (Outlines-style)
# ENABLE_REGEX_CONSTRAINTS=false
# REGEX_PATTERN=""

# JSON Schema Constraints
# ENABLE_JSON_CONSTRAINTS=false

# GBNF Grammar Constraints
# ENABLE_GRAMMAR_CONSTRAINTS=false
# GBNF_GRAMMAR=""

# Stop Token Control
# ENABLE_STOP_TOKEN_CONTROL=false
# STOP_TOKENS=["</s>", "<|end_of_text|>"]
# STOP_STRINGS=[]

# Thinking Tag Control (DeepSeek-style)
# ENABLE_THINKING_CONTROL=false
# SUPPRESS_THINKING=false
# THINKING_START_TAG="<thinking>"
# THINKING_END_TAG=""

# Token Masking & Logit Biasing
# ENABLE_TOKEN_MASKING=false
# ENABLE_LOGIT_BIASING=false
# MASK_STRATEGY=hard

# Lexical Constraints
# ENABLE_LEXICAL_CONSTRAINTS=false
# FORCED_PHRASES=[]
# FORBIDDEN_PHRASES=[]

# ----- Threading and NUMA Optimizations (optional) -----
# Cutting-edge parallel computing optimizations for efficient LLM inference
# All are disabled by default - enable only if you understand the implications

# Parallel Speedup Modeling (Amdahl, Gustafson)
# ENABLE_SPEEDUP_MODELING=false
# PARALLEL_FRACTION=0.95

# NUMA-Aware Memory Allocation
# ENABLE_NUMA_AWARE=false
# NUMA_POLICY=interleave
# NUMA_BALANCING=false

# Thread Configuration
# THREAD_COUNT=0
# ENABLE_HYPERTHREADING=true
# MAX_THREADS_PER_CORE=2

# CPU Affinity and Thread Pinning
# ENABLE_CPU_AFFINITY=false
# AFFINITY_POLICY=compact

# Memory Bandwidth Optimization
# ENABLE_BANDWIDTH_OPTIMIZATION=false
# TARGET_BANDWIDTH_UTILIZATION=0.8

# NUMA-Aware Task Scheduling
# ENABLE_NUMA_SCHEDULING=false
# SCHEDULING_POLICY=work_stealing

# ----- Prompt Engineering and Context Management (optional) -----
# Cutting-edge prompt optimization techniques for efficient LLM inference
# All are disabled by default - enable only if you understand the implications

# Prompt Compression (LLMLingua-style)
# ENABLE_PROM_COMPRESSION=false
# COMPRESSION_METHOD=perplexity_based
# COMPRESSION_RATIO=0.5
# MIN_PROMPT_LENGTH=100

# Token Importance Scoring (H2O, StreamingLLM, SnapKV)
# ENABLE_TOKEN_IMPORTANCE=false
# IMPORTANCE_METHOD=h2o
# IMPORTANCE_THRESHOLD=0.1
# TOP_K_TOKENS=100

# Chat History Truncation
# ENABLE_HISTORY_TRUNCATION=false
# TRUNCATION_STRATEGY=hybrid
# MAX_HISTORY_LENGTH=4096
# HISTORY_WINDOW_SIZE=10

# Dynamic Context Window Management
# ENABLE_DYNAMIC_CONTEXT=false
# CONTEXT_WINDOW_SIZE=8192
# TOKEN_BUDGET=4096
# SLIDING_WINDOW_OVERLAP=512

# Sampling Parameters Optimization
# ENABLE_SAMPLING_OPTIMIZATION=false
# TEMPERATURE=0.7
# TOP_K=50
# TOP_P=0.9
# REPETITION_PENALTY=1.0
# FREQUENCY_PENALTY=0.0
# PRESENCE_PENALTY=0.0

# Automatic Prompt Optimization
# ENABLE_AUTO_OPTIMIZATION=false
# OPTIMIZATION_METHOD=gradient_based
# OPTIMIZATION_ITERATIONS=10

# Entropy-Based Truncation
# ENABLE_ENTROPY_TRUNCATION=false
# ENTROPY_THRESHOLD=2.0
# MUTUAL_INFORMATION_THRESHOLD=0.5

# ----- Advanced ML Optimizations (optional) -----
# See .env.advanced.example for HRR, MoSE, Koopman, and Neural ODE optimizations
# All are disabled by default for safety
