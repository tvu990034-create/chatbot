# Cloud AI Chatbot Environment Variables
# Copy this file to .env and fill in your values

# Inference Backend Selection
# Options: simulatedcloud, openai, fastcloud, multiregion
INFERENCE_BACKEND=simulatedcloud

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-nano
OPENAI_BASE_URL=

# FastCloud Engine Configuration (for INFERENCE_BACKEND=fastcloud)
FASTCLOUD_DEFAULT_MODEL=gpt-4.1-nano
FASTCLOUD_FALLBACK_MODEL=gpt-3.5-turbo
FASTCLOUD_TIMEOUT_SEC=8.0
FASTCLOUD_MAX_CONNECTIONS=20
FASTCLOUD_KEEPALIVE_SEC=30
FASTCLOUD_HTTP_POOL_SIZE=50

# MultiRegion Engine Configuration
FASTCLOUD_REGIONS=openai-primary
FASTCLOUD_REGION_KEYS=

# DynamicRouter Engine Configuration
USE_DYNAMIC_ROUTER=false
FASTCLOUD_SIMPLE_MODEL=gpt-3.5-turbo
FASTCLOUD_SIMPLE_MAX_TOKENS=64

# Streaming Configuration
STREAM_BUFFER_SIZE=4

# SpeculativeCloud Engine Configuration
USE_SPECULATIVE_CLOUD=false
SPECULATIVE_DRAFT_MODEL=gpt-3.5-turbo
SPECULATIVE_VERIFIER_MODEL=gpt-4o

# Optimization Flags
USE_HISTORY_TRIMMING=false
USE_KV_PRUNING=false
USE_TOME=false
USE_DYNAMIC_MAX_TOKENS=true
MINIMAL_PROMPT=true
USE_SCORE_GATING=true
USE_PAGERANK_PRUNE=true
USE_DYNAMIC_INDEX_SWITCH=true
USE_ESSENTIAL_KEYWORDS=true
CHUNK_LIMIT=1
ZERO_TOKEN_ENABLED=true
FAQ_ENABLED=true
ONE_LINER_MODE=false
USE_PAGERANK_BOOST=true
PAGERANK_BOOST_GAMMA=0.1
USE_BOREDOM_STOPPER=false
PARALLEL_EMBEDDING=false
USE_QUERY_EMBEDDING_CACHE=false
RERANKER_BATCH_SIZE=32

# ---------- New Chatbot Features ----------

# Conversation Memory (Feature 1)
# Maximum number of conversation turns to keep in history
MAX_HISTORY_TURNS=20
# Path to SQLite database for persistent storage
DB_PATH=data/chatbot.db

# System Prompt Customization (Feature 2)
# Default system prompt for all sessions
DEFAULT_SYSTEM_PROMPT=You are a helpful AI assistant with expertise in machine learning, natural language processing, and technical systems. Provide clear, accurate, and detailed answers.

# Response Quality Tuning (Feature 4)
# Add quality instruction to minimal prompt (adds ~3 tokens)
QUALITY_TUNING=true

# Rate Limiting (Feature 6)
# Maximum requests per minute per session
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Tool/Function Calling (Feature 9)
# Enable tool/function calling capabilities
TOOLS_ENABLED=false

# Real-Time Web Search (Feature 10)
# Enable real-time web search using DuckDuckGo
WEB_SEARCH_ENABLED=false

# Code Interpreter (Feature 11)
# Enable sandboxed Python code execution
CODE_INTERPRETER_ENABLED=false
# Code execution timeout in seconds
CODE_INTERPRETER_TIMEOUT=5

# Voice & Speech (Feature 12)
# Enable text-to-speech endpoint
TTS_ENABLED=false
# OpenAI API key for TTS (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
# TTS model (tts-1 or tts-1-hd)
TTS_MODEL=tts-1
# TTS voice (alloy, echo, fable, onyx, nova, shimmer)
TTS_VOICE=alloy

# Image Understanding (Feature 13)
# Enable image understanding (requires vision-capable model)
VISION_ENABLED=false

# Admin Dashboard (Feature 14)
# API key for admin endpoints (required for admin operations)
ADMIN_API_KEY=your_admin_api_key_here
